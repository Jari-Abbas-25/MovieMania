# ==============================================================================
# MovieMania — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values as needed for your local environment.

# --- Application Mode ---
# Environment: development | production
APP_ENV=development

# --- Logging ---
# Log level: off | error | warn | info | debug | trace
MOVIEBOX_LOG=info

# --- Desktop / Dev Bridge Settings ---
# Port for Flutter Web development bridge (Default: 8765)
DEV_BRIDGE_PORT=8765
DEV_BRIDGE_HOST=127.0.0.1

# --- Optional Media Player Paths (Desktop only) ---
# MOVIEBOX_MPV_PATH=C:\Program Files\mpv\mpv.exe
# MOVIEBOX_VLC_PATH=C:\Program Files\VideoLAN\VLC\vlc.exe

# --- Cache & Storage ---
# Custom storage directory override (optional)
# MOVIEBOX_DATA_DIR=./data
# MOVIEBOX_CACHE_DIR=./cache
